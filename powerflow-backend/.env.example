# Database Configuration
MONGODB_URI=mongodb://localhost:27017/powerflow

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Security Configuration
API_KEY=your_api_key_here

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=Power Flow Services <noreply@powerflowservices.com>
SMTP_CLIENT_NAME=localhost

# Public backend URL for links inside invoice emails
BACKEND_PUBLIC_URL=http://localhost:3001

# Google Gmail OAuth 2.0 (Gmail API)
EMAIL_PROVIDER=gmail-oauth
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/oauth2callback
# Space or comma separated scopes are supported.
# gmail.readonly is used for best-effort mailbox verification (users.getProfile).
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly
GOOGLE_TOKEN_PATH=secure/google-oauth-token.enc
OAUTH_TOKEN_ENCRYPTION_KEY=7f9a4d2e8c1b6a5f3e0d9c8b7a6f5e4d1c2b3a4e5f6d7c8b
GMAIL_SENDER_EMAIL=powerflowservicesltd@gmail.com
ADMIN_ORDERS_URL=http://localhost:3000/admin/pages/orders.html
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/admin/pages/orders.html
GOOGLE_OAUTH_ERROR_REDIRECT_URL=http://localhost:3000/admin/pages/orders.html

# File Upload Configuration
UPLOAD_PATH=./public/uploads
UPLOAD_PUBLIC_PREFIX=/uploads
PRODUCT_UPLOAD_SUBDIR=products
PRODUCT_UPLOAD_BASE_URL=http://localhost:3001
MAX_FILE_SIZE=10485760

# Payment Configuration (for future integration)
PAYMENT_GATEWAY_API_KEY=your_payment_api_key
PAYMENT_GATEWAY_SECRET=your_payment_secret

# Analytics Configuration (for future integration)
GA_TRACKING_ID=your_ga_tracking_id

# Google Maps Configuration (for directions and location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
