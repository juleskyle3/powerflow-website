{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "/admin/assets/$1"
    },
    {
      "src": "/admin/pages/(.*)",
      "dest": "/admin/pages/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(css|js|images|fonts)/(.*)",
      "dest": "/client/$&"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
